# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=bridgtelega_bot

# Matrix
MATRIX_HS_URL=https://matrix.example.org
MATRIX_USER_ID=@bridgebot:example.org
MATRIX_ACCESS_TOKEN=

# SQLite (Docker default: /data/bridge.db)
DATABASE_PATH=/data/bridge.db

# Link code lifetime in seconds
LINK_CODE_TTL_SECONDS=3600

# Optional: restrict linking to rooms on this domain only.
# Leave commented out to allow all servers.
# MATRIX_ALLOWED_SERVER=matrix.example.org

# Message language: "en" (default) or "ru"
# LOCALE=en

# Rate limiting
RATE_LIMIT_LINK_ATTEMPTS=20
RATE_LIMIT_LINK_WINDOW_SECONDS=300
RATE_LIMIT_CODE_GENERATIONS=10
RATE_LIMIT_CODE_WINDOW_SECONDS=3600

# Language support en (English) and ru (Russian). Default is en.
LOCALE=en
